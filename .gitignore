# build output
build/
.gradle/
.cxx/
app/local.properties
*.apk
*.aab
__pycache__/
*.pyc

# generated by engine/package_runtime.py (FreeCAD/CPython runtime staged per ABI, ~500 MB each)
app/app/src/x86/
app/app/src/arm64/
app/app/src/main/jniLibs/
app/app/src/main/assets/freecad-runtime/
app/app/src/main/assets/python/

# local download server (APKs + source archives go to GitHub Releases instead)
serve/

# raw screen recordings for the launch video, and its intermediate files
release/video/clips/
release/video/build/

# on-device scan dumps (regenerated by research/parity.py)
research/gui_scan*.json

# local tooling / agent notes
.claude/
avm/
*.jks
*.keystore
keystore.properties

# Qt's Java side, copied from the Qt Android build by engine/package_runtime.py
app/app/libs/Qt6Android.jar
