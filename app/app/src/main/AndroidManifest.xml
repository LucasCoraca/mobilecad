<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <!-- BIM Library / Tutorial, IfcOpenShell updates, help pages fetched by FreeCAD's own code -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- updates from the GitHub releases (Updater.kt; release-signed builds only, F-Droid builds update through F-Droid) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- XR mode on headsets: the Khronos OpenXR loader finds the headset's runtime; none of these is needed on a phone -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" android:version="1" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService" /></intent>
        <intent><action android:name="org.khronos.openxr.OpenXRApiLayerService" /></intent>
    </queries>

    <application
        android:label="MobileCAD"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.FC"
        android:hardwareAccelerated="true"
        android:largeHeap="true">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s|quest2|questpro" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|smallestScreenSize|screenLayout|density|uiMode|fontScale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- headsets launch MobileCAD immersive (Quest: Meta, others: Khronos); MainActivity hands over to
                     XrActivity there. Phones and tablets ignore these categories. -->
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
        <!-- XR mode: the whole app in the headset (OpenXR). Started by MainActivity when the device is a headset. -->
        <activity android:name=".xr.XrActivity" android:exported="false" android:launchMode="singleTask"
            android:resizeableActivity="false" android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
        <receiver android:name=".freecad.UpdateReceiver" android:exported="false" />
    </application>
</manifest>
